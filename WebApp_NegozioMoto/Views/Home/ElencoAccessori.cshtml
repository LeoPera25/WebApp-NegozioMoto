@model dynamic
@{
    ViewData["Title"] = "Elenco Accessori";
    bool isAdmin = ViewBag.isAdmin ?? false;
}

<div class="container my-5">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">@item.tipo</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text"><strong>Compatibilità:</strong> @item.compatibilita</p>
                        <p class="card-text">@item.descrizione</p>
                        <div class="text-center my-3">
                            <img src="~/FOTOACCESSORI/@item.foto" alt="@item.tipo" class="img-fluid rounded" style="max-height: 250px; object-fit: cover;">
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="badge bg-success fs-6">€ @item.prezzo</span>
                            <small>ID: @item.ID_prodotto</small>
                        </div>
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-grid gap-2">
                            @if (isAdmin)
                            {
                                <a class="btn btn-warning" asp-action="ModificaAccessorio" asp-route-id="@item.ID_prodotto">Modifica</a>
                            }
                            else
                            {
                                <a class="btn btn-outline-primary" asp-action="AggiungiAlCarrello"
                                   asp-route-idCat="@item.ID_categoria" asp-route-idProd="@item.ID_prodotto">
                                    Aggiungi al carrello
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>